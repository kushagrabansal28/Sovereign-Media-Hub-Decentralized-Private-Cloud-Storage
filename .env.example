# Copy to .env and edit. Docker Compose reads it automatically.

# The address people type to reach the app. Used for file URLs in uploaded
# metadata, so decide before uploading: changing it later leaves old events
# pointing at the old address (the app falls back to the hash on the current server).
PUBLIC_URL=http://localhost

# ":80" serves plain HTTP. A domain name (media.example.org) turns on automatic
# HTTPS and needs ports 80 and 443 open to the internet.
SITE_ADDRESS=:80
HTTP_PORT=80
HTTPS_PORT=443

# Comma-separated public keys (hex or npub) allowed to upload. Empty means any
# valid Nostr key can store files on this server. Set it for anything public.
ALLOWED_PUBKEYS=

# Largest single file in bytes (default 100 MiB).
MAX_FILE_SIZE=104857600

# Relays offered on first run, as a JSON array. Events sent to public relays are
# readable by anyone. Leave empty to add your own relay in the app.
DEFAULT_RELAYS=[]
