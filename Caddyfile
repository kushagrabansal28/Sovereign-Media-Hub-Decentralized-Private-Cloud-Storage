:80 {
	# Optional: Replace :80 with your domain (e.g. blossom.example.com) to enable automatic HTTPS via Let's Encrypt
	
	# Route /upload, /list, / to backend
	# Route any 64 char path to backend
	handle_path /api/* {
		reverse_proxy backend:8080
	}

	@backend {
		path_regexp ^/[a-f0-9]{64}$
		path /upload
		path /list/*
		path /
	}
	handle @backend {
		reverse_proxy backend:8080
	}

	# Fallback to frontend
	handle {
		reverse_proxy frontend:80
	}
}
